<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/sideNavButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menu" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, User"
                        android:textStyle="bold"
                        android:textColor="#2C2F3B"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You're doing great — let's take today one step at a time."
                        android:textSize="13sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_notification"
                    android:contentDescription="Notifications" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_profile"
                    android:scaleType="centerCrop"
                    android:background="@drawable/profile_circle"
                    android:contentDescription="Profile" />

                <ImageView
                    android:id="@+id/btnLanguage"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_language"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Change Language"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- DAILY MOTIVATIONAL QUOTE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Motivation"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B" />

                    <TextView
                        android:id="@+id/quoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading your daily inspiration..."
                        android:textSize="16sp"
                        android:textColor="#475569"
                        android:lineSpacingExtra="6dp"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:alpha="0" />

                    <TextView
                        android:id="@+id/quoteAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:gravity="end"
                        android:layout_marginTop="12dp"
                        android:alpha="0" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BREATHING & STEP QUEST (SIDE BY SIDE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- Breathing Quest -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBreathingQuest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#7C4DFF"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/headerLayoutBreathing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_wind"
                                android:alpha="0.8"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mindfulness"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/progressContainerBreathing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_below="@id/headerLayoutBreathing"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/circle_background_alpha" />

                            <ProgressBar
                                android:id="@+id/breathingProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="5"
                                android:progress="0"
                                android:rotation="-90"
                                android:progressDrawable="@drawable/circular_progress_white" />

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_lungs"
                                android:layout_gravity="center"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/progressContainerBreathing"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvBreathingPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Start Now"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily Session"
                                android:textSize="12sp"
                                android:alpha="0.7"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Step Quest -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStepQuest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#F59E0B"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/headerLayoutStep"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_lightning"
                                android:alpha="0.8"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Movement"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/progressContainerStep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_below="@id/headerLayoutStep"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/circle_background_alpha" />

                            <ProgressBar
                                android:id="@+id/stepProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="10000"
                                android:progress="4500"
                                android:rotation="-90"
                                android:progressDrawable="@drawable/circular_progress_white" />

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_shoe"
                                android:layout_gravity="center"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/progressContainerStep"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvStepPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4,500"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Steps Today"
                                android:textSize="12sp"
                                android:alpha="0.7"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- PREMIUM CALENDAR STRIP (CLEAN SQUARE STYLE) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Week Title -->
                    <TextView
                        android:id="@+id/weekRangeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Week of 22 Dec – 28 Dec"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        android:layout_marginBottom="20dp" />

                    <LinearLayout
                        android:id="@+id/weekContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:weightSum="7" />


                    <!-- Prev / Next Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="20dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrevWeek"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Previous"
                            android:textSize="14sp"
                            app:cornerRadius="28dp"
                            app:strokeWidth="2dp"
                            app:strokeColor="#E2E8F0"
                            app:icon="@drawable/ic_chevron_left"
                            app:iconGravity="textStart"
                            app:iconTint="#64748B"
                            android:layout_marginEnd="32dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextWeek"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next"
                            android:textSize="14sp"
                            app:cornerRadius="28dp"
                            app:strokeWidth="2dp"
                            app:strokeColor="#E2E8F0"
                            app:icon="@drawable/ic_chevron_right"
                            app:iconGravity="textEnd"
                            app:iconTint="#64748B" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TODAY'S PLAN -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Plan"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B" />

                    <TextView
                        android:id="@+id/selectedDateEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Tap a day to add your notes &amp; tasks"
                        android:textSize="15sp"
                        android:textColor="#475569"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WATER + GRATITUDE PREVIEW CARDS (CLICK TO OPEN FULL ACTIVITY) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp">

                <!-- WATER QUEST PREVIEW -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardWaterQuest"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#2962FF"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/headerLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_water_drop"
                                android:alpha="0.8"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hydration"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/progressContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_below="@id/headerLayout"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/circle_background_alpha" />

                            <ProgressBar
                                android:id="@+id/waterProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="8"
                                android:progress="5"
                                android:rotation="-90"
                                android:progressDrawable="@drawable/circular_progress_white" />

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_water_glass_outline"
                                android:layout_gravity="center"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/progressContainer"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvWaterPreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 / 8"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Glasses Today"
                                android:textSize="12sp"
                                android:alpha="0.7"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- GRATITUDE GARDEN PREVIEW -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGratitudeGarden"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#10B981"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/headerLayoutGratitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_leaf"
                                android:alpha="0.8"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gratitude"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textAllCaps="true"
                                android:letterSpacing="0.05"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/progressContainerGratitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_below="@id/headerLayoutGratitude"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="100"
                                android:progress="100"
                                android:progressDrawable="@drawable/circle_background_alpha" />

                            <ProgressBar
                                android:id="@+id/gratitudeProgressBar"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:max="10"
                                android:progress="3"
                                android:rotation="-90"
                                android:progressDrawable="@drawable/circular_progress_white" />

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_flower_seed"
                                android:layout_gravity="center"
                                app:tint="#FFFFFF" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/progressContainerGratitude"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tvGratitudePreview"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 Flowers"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Planted Today"
                                android:textSize="12sp"
                                android:alpha="0.7"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FDFDFD"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>