<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Gradient background -->
    <gradient
        android:startColor="#CFF1FF"
        android:endColor="#E0D9FF"
        android:angle="135" />

    <!-- Optional subtle shadow on API 21+ (elevation is better though) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
