<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- KONFETTI EXPLOSION - Full screen overlay -->
    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- MAIN CONTENT - Scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ONLY ONE CHILD ALLOWED HERE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- WEEKLY BAR CHART -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/weeklyChart"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginBottom="30dp"
                android:background="#FFFFFF" />

            <TextView
                android:id="@+id/stepsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Steps: 0"
                android:textSize="42sp"
                android:textStyle="bold"
                android:textColor="#3B82F6"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/goalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal: 5000"
                android:textSize="18sp"
                android:textColor="#64748B"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#10B981"
                android:layout_marginBottom="30dp" />

            <TextView
                android:id="@+id/challengeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Challenge: 100 steps in 60s — Ready!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#E0E7FF"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/bonusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#D1FAE5"
                android:padding="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/achievementText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="#FEF3C7"
                android:padding="16dp"
                android:visibility="gone"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/streakText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streak: 0 days"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnLeaderboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leaderboard"
                    android:backgroundTint="#8B5CF6"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="20dp" />

                <Button
                    android:id="@+id/btnAchievements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Badges"
                    android:backgroundTint="#F59E0B"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>