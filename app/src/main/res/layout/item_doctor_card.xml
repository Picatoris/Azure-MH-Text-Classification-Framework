<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_bg"
    android:padding="20dp"
    android:layout_margin="10dp"
    android:elevation="8dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/doctorImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/bell_icon"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_bg"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/doctorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dr. Anand"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/availabilityStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Now ●"
        android:textColor="#4CAF50"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/doctorDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Passionate about evidence-based treatment..."
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/languages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Languages: Hindi, English, Tamil"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/expertise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expertise: CBT"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/availability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Availability: Mon to Fri"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Star ratings -->
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/happy_icon"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/happy_icon"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/happy_icon"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/happy_icon"/>
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/happy_icon"/>
    </LinearLayout>
</LinearLayout>
